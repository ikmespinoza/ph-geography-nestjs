# PH Geography API — environment
# Copy to `.env` and adjust. The environment is validated at boot (Zod, fail-fast):
# a missing/invalid required variable exits non-zero with a readable error.
# `.env` is gitignored — only this example is committed.

# ── App ─────────────────────────────────────────────────────────────────────
# Runtime environment: development | test | production
NODE_ENV=development
# HTTP listen port (1–65535)
PORT=3000

# ── Database (PHG-003) ──────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://ph_geography:ph_geography@localhost:5432/ph_geography
# Host port the docker-compose database publishes (default 5432). Override only
# if 5432 is already in use locally — then match the port in DATABASE_URL above.
# Consumed by docker-compose.yml; the app itself connects via DATABASE_URL.
DB_PORT=5432

# ── Ingestion / scraper (PHG-011+) ──────────────────────────────────────────
# Cron expression for the scheduled scrape (default: daily at 03:00)
INGESTION_SCHEDULE_CRON=0 3 * * *
# Per-request fetch timeout, milliseconds
INGESTION_REQUEST_TIMEOUT_MS=15000
# User-Agent sent by the scraper
INGESTION_USER_AGENT=ph-geography-api/1.0 (+https://github.com/ikmespinoza/ph-geography-nestjs)
# Retry attempts after a failed fetch (0–10; transient errors only)
INGESTION_MAX_RETRIES=2
# Base backoff between fetch attempts, doubled per attempt
INGESTION_RETRY_BACKOFF_MS=500
# Arm the scheduled scrape in this process (true|false). `pnpm ingest` sets it
# to false so the CLI never also fires the cron.
INGESTION_ENABLE_SCHEDULE=true

# ── Sources (ISO 3166 scrape URLs — allow-listed) ───────────────────────────
# Wikipedia page listing PH regions & provinces (ISO 3166-2:PH)
SOURCE_ISO3166_REGION_URL=https://en.wikipedia.org/wiki/ISO_3166-2:PH
# Wikipedia page listing PH cities & municipalities
SOURCE_ISO3166_CITY_URL=https://en.wikipedia.org/wiki/List_of_cities_and_municipalities_in_the_Philippines

# ── Cache (PHG-015) ─────────────────────────────────────────────────────────
# Cache read responses (true|false). The test suites set this to false so a
# cached first response can't answer a later assertion.
CACHE_ENABLED=true
# Response time-to-live in MILLISECONDS (cache-manager v6+ takes ms, not seconds)
CACHE_TTL_MS=60000

# ── Hardening & logging (PHG-017 / OD-12) ───────────────────────────────────
# Arm the rate limiter (true|false)
THROTTLE_ENABLED=true
# Rate-limit window in MILLISECONDS (@nestjs/throttler v5+ takes ms, not seconds)
THROTTLE_TTL_MS=60000
# Requests allowed per window, per client
THROTTLE_LIMIT=120
# Allowed CORS origins: comma-separated list, or `*`. The API is public,
# read-only and sent without credentials, so `*` is a correct default.
CORS_ORIGINS=*
# pino level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
