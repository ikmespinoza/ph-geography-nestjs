# PH Geography API — environment
# Copy to `.env` and adjust. The environment is validated at boot (Zod, fail-fast):
# a missing/invalid required variable exits non-zero with a readable error.
# `.env` is gitignored — only this example is committed.

# ── App ─────────────────────────────────────────────────────────────────────
# Runtime environment: development | test | production
NODE_ENV=development
# HTTP listen port (1–65535)
PORT=3000

# ── Database (PHG-003) ──────────────────────────────────────────────────────
# REQUIRED. PostgreSQL connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://ph_geography:ph_geography@localhost:5432/ph_geography

# ── Ingestion / scraper (PHG-011+) ──────────────────────────────────────────
# Cron expression for the scheduled scrape (default: daily at 03:00)
INGESTION_SCHEDULE_CRON=0 3 * * *
# Per-request fetch timeout, milliseconds
INGESTION_REQUEST_TIMEOUT_MS=15000
# User-Agent sent by the scraper
INGESTION_USER_AGENT=ph-geography-api/1.0 (+https://github.com/ikmespinoza/ph-geography-nestjs)

# ── Sources (ISO 3166 scrape URLs — allow-listed) ───────────────────────────
# Wikipedia page listing PH regions & provinces (ISO 3166-2:PH)
SOURCE_ISO3166_REGION_URL=https://en.wikipedia.org/wiki/ISO_3166-2:PH
# Wikipedia page listing PH cities & municipalities
SOURCE_ISO3166_CITY_URL=https://en.wikipedia.org/wiki/List_of_cities_and_municipalities_in_the_Philippines
