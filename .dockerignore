# What must never enter the build context (PHG-020).
#
# Mostly this keeps the context small — but two entries are CORRECTNESS, not size:
#
#   *.tsbuildinfo  — `nest build` sets deleteOutDir, which wipes dist/, while
#                    tsconfig sets incremental, which trusts the buildinfo. Ship a
#                    stale tsconfig.build.tsbuildinfo into the context and the
#                    compiler concludes there is nothing to do and emits NOTHING:
#                    the build succeeds and the image contains an empty dist/ that
#                    dies at CMD with MODULE_NOT_FOUND.
#   dist/          — same trap from the other side; every image build must be cold.

# Dependencies (reinstalled per stage, and host binaries are the wrong platform)
node_modules/
.pnpm-store/

# Build output — see above
dist/
*.tsbuildinfo

# Test artefacts. test/ alone is ~3.3 MB of HTML fixtures the runtime never reads;
# src specs are excluded from tsconfig.build.json anyway.
test/
coverage/
**/*.spec.ts

# Secrets / local config. The container is configured by environment variables; a
# copied .env would also carry a localhost DATABASE_URL that cannot resolve inside
# the network.
.env
.env.*
.env.example

# Generated Prisma client — regenerated by `prisma generate` in the deps stage
src/generated/

# VCS, tooling and editor state
.git/
.github/
.husky/
.claude/
.vscode/
.idea/
.editorconfig
.prettierrc
.prettierignore
eslint.config.mjs
nodemon.json
jest.config.ts
Dockerfile
.dockerignore
docker-compose.yml

# Docs
README.md
MIGRATION.md
LICENSE

# Logs / OS noise
*.log
.DS_Store
Thumbs.db
